% Macros of the interview books (18, 19, 20). Loaded after onequant.sty, which every other book uses.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ivbook}[2026/11/02 The interview books]

% UI strings: this book has questions and answers.
\renewcommand{\omsolutionspart}{Answers}
\renewcommand{\omsolutionof}{Answer to}
\renewcommand{\omnameGotoSolution}{Answer p.}

% A question: \begin{question}[$\star\star$ \iqroles{QR, QT} \iqfirm{market maker, hedge fund} \iqlevel{junior}]
%             \label{iq:iv:<slug>:<n>} ... \end{question}
% Stars give the target time; the tags say who should train on it. Timed tests carry no tags.
\theoremstyle{remark}
\newtheorem{question}{Question}[chapter]
% As \omdecorate, but a question stays whole on one page: a stem is short and is read as one thing.
\tcolorboxenvironment{question}{%
  enhanced jigsaw, unbreakable, frame hidden,
  boxrule=0pt, sharp corners,
  borderline west={2pt}{0pt}{omIq},
  left=8pt, right=4pt, top=4pt, bottom=4pt,
  before skip=10pt, after skip=10pt,
  colback=omIq!4!white}
\crefname{question}{Question}{Questions}
\Crefname{question}{Question}{Questions}
\AtBeginEnvironment{question}{\ifomsollinks\omsollink@arm\fi}
\AtEndEnvironment{question}{\ifomsollinks\omsollink@emit\fi}
\newcommand{\iqlevel}[1]{{\normalfont\footnotesize\itshape\color{omIq}\,\textbullet\ #1}}

% The parts of an answer, each run in after the result and the derivation.
\newcommand{\iv@runin}[1]{\par\smallskip\noindent{\bfseries\color{omIq}#1.}\ }
\newcommand{\iqwrong}[1]{\iv@runin{Classic wrong answer}#1}
\newcommand{\iqfollow}[2]{\iv@runin{Follow-up}{\itshape #1}\ #2}
\newcommand{\iqwhy}[1]{\iv@runin{Why it matters}#1}

% Figures appear only in the answers, where the chapter counter is empty: number them straight through the book.
\counterwithout{omfig}{chapter}

% Opening of a section of a timed test: \ivtestsection{A}{6}{40}
\newcommand{\ivtestsection}[3]{\section*{Section #1 --- #2 questions, #3 minutes}}

% What a chapter trains, in two or three lines, under the chapter title.
\newenvironment{ivtrains}{\par\noindent\itshape\ignorespaces}{\par\medskip}

% Drill sheets: a page of items, then a key. Generated by the chapter's script.
\newcommand{\ivdrill}[2]{\makebox[1.7em][r]{\scriptsize\color{omIq}#1}\enspace #2 $=$}
\newenvironment{ivdrillsheet}{\par\smallskip\noindent\renewcommand{\arraystretch}{1.5}\everymath{\displaystyle}%
  \let\iv@frac\frac\renewcommand{\frac}[2]{\iv@frac{##1}{##2}\rule[-2.4ex]{0pt}{6ex}}%
  \begin{tabular}{@{}p{.31\linewidth}p{.31\linewidth}p{.29\linewidth}@{}}}{\end{tabular}\par}
\newcommand{\ivkey}[2]{\makebox[1.7em][r]{\scriptsize\color{omIq}#1}\enspace #2}
\newenvironment{ivdrillkey}{\par\smallskip\noindent\small\renewcommand{\arraystretch}{1.3}\everymath{\displaystyle}%
  \begin{tabular}{@{}*{5}{p{.175\linewidth}}@{}}}{\end{tabular}\par\smallskip}
\newcommand{\ivfamily}[3]{\par\smallskip\noindent\textbf{#1} {\small(items #2).}\ #3}

% Played games: the stop line before each round of a script, and a scrambled table of results.
\newcommand{\ivround}[1]{\par\medskip\noindent\textbf{Round #1.}\ \ignorespaces}
\newcommand{\ivstop}{\par\smallskip\noindent{\color{omIq}\dotfill\ \textbf{\small Stop. Write your answer before you read below this line.}\ \dotfill}\par\smallskip\noindent\ignorespaces}
\newcommand{\ivsays}[1]{\textit{Interviewer:} ``#1''\par\smallskip\noindent\ignorespaces}
\newcommand{\ivcell}[2]{\mbox{#1\,\textbf{#2}}}
\newcommand{\ivlookup}[1]{\par\smallskip{\footnotesize\raggedright\noindent #1\par}\smallskip}
\newcommand{\ivscoreline}[1]{#1 & & & & & \\[8pt]\hline}

% Four options under a drill item, for a multiple-choice sheet.
\newcommand{\ivoptions}[4]{\newline\hspace*{21pt}{\footnotesize\textbf{A}\,$#1$\quad\textbf{B}\,$#2$\newline\hspace*{21pt}\textbf{C}\,$#3$\quad\textbf{D}\,$#4$}}

% A question chapter has no \section, and odd pages show the section's mark, so their heads would stay empty.
% Start every chapter with its title as that mark. A real \section still replaces it.
\AtBeginDocument{%
  \let\iv@chaptermark\chaptermark
  \renewcommand{\chaptermark}[1]{%
    \iv@chaptermark{#1}%
    \markright{\protect\omTocMark{\@currentHref}{#1}}}}
